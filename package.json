{
  "name": "mandate",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@base-org/account": "2.5.10",
    "@mobile-wallet-protocol/client": "^1.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.102.8",
    "buffer": "^6.0.3",
    "decode-uri-component": "file:./packages/decode-uri-component-compat",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react": "1.42.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "viem": "^2.56.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npm run web:build && npm run web:serve",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:ui": "NODE_ENV=test agent/node_modules/.bin/tsx --test scripts/ui-presentation.test.mjs",
    "prebuild": "expo prebuild -p ios --clean",
    "web:build": "EXPO_NO_DOTENV=1 expo export --platform web",
    "web:serve": "node web/server.mjs",
    "test:web": "node --test web/*.test.mjs",
    "web:cloud": "npm run web:build && node web/prepare-cloud.mjs"
  },
  "overrides": {
    "react-dom": "19.2.3",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "decode-uri-component": "$decode-uri-component",
    "xcode": {
      "uuid": "11.1.1"
    },
    "@coinbase/cdp-sdk": {
      "axios": "1.20.0"
    }
  },
  "private": true
}
