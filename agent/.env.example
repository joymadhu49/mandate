# Spender EOA that receives Spend Permissions and executes trades. Fund with a little ETH on Base for gas.
# Leave empty to let the backend create and keep a key in data/spender.key (owner-only file, created once).
AGENT_PRIVATE_KEY=
# Execution mode. Unset/1: simulation by default, switchable from the app (Settings → Live mode) and
# remembered in data/db.json.mode.json. 0: pin live. LOCK_MODE=1 pins the remembered mode.
DRY_RUN=1
# Wallets allowed to switch the mode from the app (comma-separated). Set this whenever the backend is reachable from the internet.
OWNER_ACCOUNTS=
BASE_RPC_URL=https://mainnet.base.org
OPENROUTER_API_KEY=
MODEL=google/gemini-2.5-flash
# Optional in-app key/model setup and instruction drafting. Dry-run only, never production.
DEV_AI_SETTINGS=1
# In-app settings use the verified wallet session; no separate setup token is needed.
# How often the agent evaluates every active mandate (minutes)
AGENT_INTERVAL_MIN=30
PORT=8842

# Swap venue. Relay by default; SWAP_PROVIDER=lifi falls back to LI.FI.
SWAP_PROVIDER=relay
# Optional: Relay attribution and higher rate limits (https://docs.relay.link/references/api/api-keys). Trading works without it.
RELAY_API_KEY=
