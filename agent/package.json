{
  "name": "mandate-agent",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test src/*.test.ts",
    "cloud:types": "wrangler types --include-env false",
    "cloud:check": "npm run cloud:types && tsc --noEmit -p tsconfig.worker.json && wrangler deploy --dry-run",
    "cloud:deploy": "wrangler deploy",
    "cloud:dev": "wrangler dev"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "viem": "^2.56.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "wrangler": "4.129.1"
  }
}
